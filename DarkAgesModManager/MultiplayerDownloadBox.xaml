<Window x:Class="DarkAgesModManager.MultiplayerDownloadBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DarkAgesModManager"
        mc:Ignorable="d"
        Title="Download in Progress" Height="250" Width="250" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Closing="OnClosing" Loaded="OnLoaded" >
    <Grid>
        <TextBlock Name="TextBlockStatus" Text="Starting Download" HorizontalAlignment="Center" Margin="0,24,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Height="93" Width="230" TextAlignment="Center"/>
        <TextBlock Name="TextBlockProgress" Text="Progress: 0%" HorizontalAlignment="Center" Margin="0,134,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="144" TextAlignment="Center"/>
        <Button    Name="ButtonCancelDownload" Content="Cancel Download"  HorizontalAlignment="Center" Margin="0,166,0,0" VerticalAlignment="Top" Click="ButtonCancelDownload_Click" Width="108" MinWidth="108" MinHeight="24"/>
    </Grid>
</Window>

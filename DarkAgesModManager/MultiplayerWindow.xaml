<Window x:Class="DarkAgesModManager.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DarkAgesModManager"
        mc:Ignorable="d"
        Title="Download Multiplayer Mods" Height="775" Width="610" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
    <Grid Name="MainGrid" Background="Black">
        <Image HorizontalAlignment="Left" Width="433" Height="252" VerticalAlignment="Top" Source="/img_svs.jpg"/>
        <Image HorizontalAlignment="Left" Height="254" Margin="0,245,0,0" VerticalAlignment="Top" Width="433" Source="/img_coop.jpg"/>
        <Image HorizontalAlignment="Left" Height="250" Margin="0,490,0,0" VerticalAlignment="Top" Width="433" Source="/img_invasion.jpg"/>

        <Button Name ="Button_DownloadInvasion" Content="Download Invasion" HorizontalAlignment="Left" Margin="441,576,0,0" VerticalAlignment="Top" Height="36" Width="146" Click="Button_DownloadInvasion_Click"/>
        <Button Name ="Button_DownloadSVS"   Content="Download Slayer vs Slayer" HorizontalAlignment="Left" Margin="441,86,0,0" VerticalAlignment="Top" Width="146" Height="36" Click="Button_DownloadSVS_Click"/>
        <Button Name ="Button_DownloadCoop"  Content="Download Coop" HorizontalAlignment="Left" Margin="441,331,0,0" VerticalAlignment="Top" Height="36" Width="146" Click="Button_DownloadCoop_Click"/>
        <Button Name ="Button_AboutCoop"     Content="About + Mirrors" HorizontalAlignment="Left" Margin="461,372,0,0" VerticalAlignment="Top" Width="106" Height="28" Click="Button_AboutCoop_Click"/>
        <Button Name ="Button_AboutInvasion" Content="About + Mirrors" HorizontalAlignment="Left" Margin="461,617,0,0" VerticalAlignment="Top" Width="106" Height="28" Click="Button_AboutInvasion_Click" />
        <Button Name ="Button_AboutSvs"      Content="About + Mirrors" HorizontalAlignment="Left" Margin="461,127,0,0" VerticalAlignment="Top" Width="106" Height="28" Click="Button_AboutSvs_Click" />

    </Grid>
</Window>

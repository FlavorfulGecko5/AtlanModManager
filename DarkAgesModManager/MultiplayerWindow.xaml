<Window x:Class="DarkAgesModManager.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DarkAgesModManager"
        mc:Ignorable="d"
        Title="Download Multiplayer Mods" Height="784" Width="610" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
    <Grid Name="MainGrid" Background="Black">
        <Image HorizontalAlignment="Left" Width="427" Height="293" VerticalAlignment="Top" Source="/img_svs.jpg"/>
        <Image HorizontalAlignment="Left" Height="249" Margin="0,251,0,0" VerticalAlignment="Top" Width="427" Source="/img_coop.jpg"/>
        <Image HorizontalAlignment="Left" Height="250" Margin="0,501,0,0" VerticalAlignment="Top" Width="427" Source="/img_invasion.jpg"/>

        <Button Name ="Button_DownloadInvasion" Content="Download Invasion" HorizontalAlignment="Left" Margin="452,585,0,0" VerticalAlignment="Top" Height="36" Width="153" Click="Button_DownloadInvasion_Click"/>
        <Button Name ="Button_DownloadSVS" Content="Download Slayer vs Slayer" HorizontalAlignment="Left" Margin="438,120,0,0" VerticalAlignment="Top" Width="146" Height="33" Click="Button_DownloadSVS_Click"/>
        <Button Name ="Button_DownloadCoop" Content="Download Coop" HorizontalAlignment="Left" Margin="452,355,0,0" VerticalAlignment="Top" Height="32" Width="118" Click="Button_DownloadCoop_Click"/>

    </Grid>
</Window>
